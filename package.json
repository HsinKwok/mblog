{
  "name": "mblog-workers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MBlog 微博客系统 - Cloudflare Workers 版（1:1 还原 Java 版功能）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "covers": "node scripts/build-covers.mjs",
    "db:init:local": "wrangler d1 execute mblog --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute mblog --remote --file=./schema.sql"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "wrangler": "^4.129.1"
  }
}
